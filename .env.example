# ============================================================
# VIA 강점 피드백 앱 — 환경변수 템플릿
#
# 사용법
#   1. 이 파일을 복사해서 .env.local 로 만든다
#        cp .env.example .env.local
#   2. .env.local 에 실제 값을 채운다
#   3. .env.local 은 절대 커밋하지 않는다 (.gitignore 확인)
#   4. 이 파일(.env.example)에는 값을 채우지 말고 빈칸으로 커밋한다
#
# Vercel 배포 시
#   Project Settings → Environment Variables 에 아래 항목을 동일하게 등록
#   NEXT_PUBLIC_ 이 아닌 값은 Production / Preview 에만 넣고 노출 금지
# ============================================================


# ------------------------------------------------------------
# 1. Supabase 연결 (브라우저에 노출되는 공개 값)
#
# 찾는 곳: Supabase 대시보드 → 좌측 하단 Project Settings
#          → API → Project URL / Project API keys
# ------------------------------------------------------------

# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" 이라고 표시된 키
# 브라우저에 그대로 노출되는 것이 정상이다. RLS 정책이 실제 방어선이므로
# 이 키가 공개돼도 안전하도록 정책을 설계해야 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------
# 2. 타입 자동 생성용
#
# 찾는 곳: Project Settings → General → Reference ID
#          (또는 Project URL 의 https://<이 부분>.supabase.co)
#
# 사용: npm run gen:types
# ------------------------------------------------------------

SUPABASE_PROJECT_ID=


# ------------------------------------------------------------
# 3. 관리자 로그인 (Supabase Auth)
#
# 환경변수로 설정할 것이 없다.
# 관리자는 admin_allowlist 테이블로 관리하며, /admin/settings 에서
# 추가·제거한다. 재배포가 필요 없다.
#
# 최초 관리자 1명은 supabase/schema.sql 의 seed 에 본인 이메일을 넣는다.
#
# Google 로그인 설정 (Supabase 대시보드에서, 코드 아님)
#   1) Google Cloud Console 에서 OAuth 클라이언트 생성
#   2) 승인된 리디렉션 URI:
#        https://<project>.supabase.co/auth/v1/callback
#   3) Supabase → Authentication → Providers → Google 에
#      클라이언트 ID / 시크릿 입력
#   4) Supabase → Authentication → URL Configuration 에
#      Site URL 과 Redirect URLs 등록
#      ⚠ Vercel 프리뷰 주소도 넣어야 프리뷰에서 로그인이 된다
#
# ⚠ service_role 키는 이 앱에서 사용하지 않는다.
#   권한 판단은 전부 RLS 의 is_admin() 이 한다.
# ------------------------------------------------------------


# ------------------------------------------------------------
# 4. 클라이언트 식별 해시용 pepper
#
# 생성: openssl rand -base64 32
#
# ⚠ 반드시 Supabase 쪽에도 같은 값을 넣어야 한다.
#   submit_feedback · get_my_submissions RPC 가 이 값으로 해싱하기 때문에
#   두 값이 다르면 "이전에 남김" 표시와 진행률이 동작하지 않는다.
#
#   Supabase SQL Editor 에서 1회 실행:
#     ALTER DATABASE postgres SET app.device_pepper = '여기에_같은_값';
#   실행 후 Project Settings → Database → Restart 로 반영
#
# ⚠ 한번 정하면 바꾸지 말 것.
#   값을 바꾸면 기존 client_hash 와 매칭되지 않아
#   이미 쌓인 제출 이력이 전부 다른 기기로 인식된다.
# ------------------------------------------------------------

DEVICE_ID_PEPPER=
