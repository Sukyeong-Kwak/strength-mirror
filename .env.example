# ============================================================
# VIA 강점 피드백 앱 — 환경변수 템플릿
#
# 사용법
#   1. 이 파일을 복사해서 .env.local 로 만든다
#        cp .env.example .env.local
#   2. .env.local 에 실제 값을 채운다
#   3. .env.local 은 절대 커밋하지 않는다 (.gitignore 확인)
#   4. 이 파일(.env.example)에는 값을 채우지 말고 빈칸으로 커밋한다
#
# Vercel 배포 시
#   Project Settings → Environment Variables 에 아래 항목을 동일하게 등록
#   NEXT_PUBLIC_ 이 아닌 값은 Production / Preview 에만 넣고 노출 금지
# ============================================================


# ------------------------------------------------------------
# 1. Supabase 연결 (브라우저에 노출되는 공개 값)
#
# 찾는 곳: Supabase 대시보드 → 좌측 하단 Project Settings
#          → API → Project URL / Project API keys
# ------------------------------------------------------------

# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" 이라고 표시된 키
# 브라우저에 그대로 노출되는 것이 정상이다. RLS 정책이 실제 방어선이므로
# 이 키가 공개돼도 안전하도록 정책을 설계해야 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------
# 2. 타입 자동 생성용
#
# 찾는 곳: Project Settings → General → Reference ID
#          (또는 Project URL 의 https://<이 부분>.supabase.co)
#
# 사용: npm run gen:types
# ------------------------------------------------------------

SUPABASE_PROJECT_ID=


# ------------------------------------------------------------
# 3. 관리자 로그인 (Supabase Auth — 이메일 인증번호)
#
# 환경변수로 설정할 것이 없다.
# 관리자는 admin_allowlist 테이블로 관리하며, /admin/settings 에서
# 추가·제거한다.
#
# 최초 관리자 1명은 supabase/schema.sql 의 seed 에 본인 이메일을 넣는다.
#
# 로그인은 이메일 6자리 인증번호(OTP)만 쓴다. 소셜 로그인은 쓰지 않는다.
#
# ⚠ 코드는 shouldCreateUser: false 로 요청한다.
#   Supabase 에 계정이 없는 주소로는 코드가 가지 않는다는 뜻이다.
#   관리자 계정은 반드시 대시보드에서 미리 만들어야 한다.
#   (Authentication → Users → Add user)
#   이렇게 하지 않으면 아무나 코드를 요청해 메일 할당량을 소진시킬 수 있다.
#
# 대시보드에서 할 일 (코드 아님)
#   1) Authentication → Providers → Email 켜기
#      Confirm email 과 Secure email change 가 켜져 있는지 확인한다.
#      꺼져 있으면 이메일을 관리자 주소로 바꿔 권한을 가로챌 수 있다
#   2) Authentication → Users → Add user 로 관리자 계정 생성
#   3) Authentication → URL Configuration 에 Site URL 과 Redirect URLs 등록
#      ⚠ Vercel 프리뷰 주소도 넣어야 프리뷰에서 로그인이 된다
#   4) 메일 발송은 Resend 커스텀 SMTP 를 쓴다 (아래)
#
# 메일 발송 — Resend SMTP
#   Supabase 기본 SMTP 는 시간당 발송 제한이 매우 낮아 인증번호가 막힌다.
#   resend.com 에서 API 키를 발급받아
#   Supabase → Authentication → SMTP Settings 에 입력한다.
#     Host     smtp.resend.com
#     Port     465
#     User     resend
#     Password 발급받은 API 키
#     Sender   Resend 에서 인증한 도메인의 주소
#   도메인이 없으면 Resend 의 테스트 발신 주소로 시작해도 된다.
#
#   ⚠ API 키는 Supabase 대시보드에만 넣는다. 이 파일에 두지 않는다.
#
# ⚠ service_role 키는 이 앱에서 사용하지 않는다.
#   권한 판단은 전부 RLS 의 is_admin() 이 한다.
# ------------------------------------------------------------


# ------------------------------------------------------------
# 4. 그 밖에 채울 것은 없다
#
# 기기 식별용 pepper 는 더 이상 쓰지 않는다.
# 중복 제출은 submission_key(클라이언트가 만드는 멱등 키)가 막고,
# "이전에 남김" 표시는 localStorage 로 처리한다.
# 서버에는 제출자를 식별하는 값이 하나도 남지 않는다.
# ------------------------------------------------------------
